# Synex Health backend configuration. Copy to backend/.env (or export these in your shell) --
# Authentication must be explicitly configured; unset mode refuses startup.

# --- Auth -----------------------------------------------------------------------------------
# demo: isolated synthetic accounts require access-code login and server sessions.
# oidc: verifies a real bearer token via JWKS -- requires OIDC_ISSUER/OIDC_AUDIENCE below, and is
# unverified against a real campus SSO from this environment (see services/auth.py's docstring).
AUTH_MODE=demo
SYNEX_ALLOW_DEMO=true
# Local development only. Never reuse on a reachable server.
DEMO_ACCESS_CODE=local-dev-only-change-me
# OIDC_ISSUER=
# OIDC_AUDIENCE=

# --- Health Agent (AI) ------------------------------------------------------------------------
# deterministic (default): rule-based, template Korean explanations -- no external API call, works
# with zero configuration. See health/health_agent.py.
# llm: calls the Anthropic Messages API using the prompts in backend/prompts/. Falls back to
# deterministic automatically if ANTHROPIC_API_KEY is unset or the API call/JSON parse fails.
HEALTH_AGENT_MODE=deterministic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=

# --- CORS (credentialed -- see main.py's resolve_cors_config docstring for why '*' is refused
# together with credentials) --------------------------------------------------------------------
SYNEX_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SYNEX_CORS_ALLOW_CREDENTIALS=true

# --- Data paths (default to backend/data/*.sqlite3; override to relocate) -----------------------
# SYNEX_HEALTH_DB_PATH=
# SYNEX_HEALTH_AUTH_SESSION_PATH=

# --- Demo seed --------------------------------------------------------------------------------
# Seeds one demo student (김지민, two real measurements) + one demo counselor + one demo admin at
# startup. Set to false for a from-scratch deployment.
SYNEX_HEALTH_DEMO_SEED=true

# --- Real provider integrations (not configured in this environment -- see
# health/providers/inbody.py and biogram.py; both raise a clean 501 until these are set) ----------
# INBODY_API_BASE_URL=
# INBODY_API_KEY=
# BIOGRAM_API_BASE_URL=
# BIOGRAM_API_KEY=

# Subscriptions: disabled (default), demo (AUTH_MODE=demo only), revenuecat (AUTH_MODE=oidc only).
BILLING_MODE=disabled
REVENUECAT_SECRET_KEY=
REVENUECAT_ENTITLEMENT=plus
REVENUECAT_PRODUCTS=synex_plus_monthly,synex_plus_yearly
REVENUECAT_WEBHOOK_AUTH=
REVENUECAT_ALLOW_SANDBOX=false
# For native apps, add capacitor://localhost and https://localhost to explicit CORS origins.

# Explicit store products: purchase UI remains disabled without both IDs and entitlement.
APPLE_PRODUCT_ID=
GOOGLE_PRODUCT_ID=
ENTITLEMENT_ID=plus
# APP_ENV=production always rejects RevenueCat sandbox entitlements.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

LEGAL_OPERATOR="Synex Health 운영팀"

SUPPORT_EMAIL="hundol047@gmail.com"

RETENTION_POLICY="계정 삭제 또는 데이터 삭제 요청 시까지"

# Real-video evidence is required before enabling production pose feedback.
POSE_COACHING_ENABLED=false
POSE_VALIDATION_REPORT=
