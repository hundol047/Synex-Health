# Local web development can leave API base blank (Vite proxy).
VITE_API_BASE=
# Native build: set these in .env.production.local (not committed).
# VITE_API_BASE=https://your-deployed-api.example
VITE_OIDC_ISSUER=
VITE_OIDC_CLIENT_ID=
# Public SDK keys only. NEVER put RevenueCat secret keys in VITE variables.
VITE_REVENUECAT_IOS_KEY=
VITE_REVENUECAT_ANDROID_KEY=
